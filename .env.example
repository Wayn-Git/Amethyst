# Copy to .env. Docker Compose reads it; git and Docker both ignore it.
#
# Names only in this file, never values. The repository is public.

# ---------------------------------------------------------------- providers
#
# Optional. AMETHYST reads these through providers.yaml's api_key_env, so a key
# given this way needs neither the OS keychain nor the secrets file. You can
# also add keys from the interface once it is running, which is the usual way.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
TYPESAFE_API_KEY=

# ------------------------------------------------------- app registrations
#
# The OAuth client AMETHYST identifies *itself* with. This is the app's identity,
# never an account's: whoever runs this container still signs in with their own
# Google or Spotify account, and their tokens stay in their own volume. Nobody
# reaches anybody else's mail by sharing a client id.
#
# Left blank on purpose, and blank is a working configuration -- connectors
# that need one will say so and link their setup page.
#
# Before filling these in, know what a shared client actually buys, because it
# is less than it sounds:
#
#   Google  -- an app in Testing requires you to add every user by email in the
#              Cloud console (100 max), and Google expires a test user's grant
#              after 7 days, refresh token included. Publishing is blocked
#              twice over: Gmail scopes are restricted and need a paid CASA
#              assessment, and Branding needs a domain you can verify in Search
#              Console. So a shared client removes setup for you and changes
#              nothing for anyone else.
#   Spotify -- the same shape, milder: 25 users in Development Mode, each added
#              by email in the dashboard.
#
# There is deliberately no GitHub slot. A GitHub OAuth App needs its client
# secret at token exchange, so a default would mean handing that secret to
# everyone. It cannot read anyone's repositories, but it authorises the app --
# and a leaked one lets a stranger run a convincing consent screen under your
# app's name. A GitHub App with device flow is the right fix, and is not built.
#
# Connectors that need none of this and work out of the box: fetch, memory,
# playwright, chrome-devtools, Vercel (it supports dynamic registration), and
# Microsoft To Do (Microsoft's own public client, device code -- you sign into
# your own Microsoft account and AMETHYST stores no client credential at all).
AMETHYST_DEFAULT_GOOGLE_CLIENT_ID=
AMETHYST_DEFAULT_GOOGLE_CLIENT_SECRET=
AMETHYST_DEFAULT_SPOTIFY_CLIENT_ID=
AMETHYST_DEFAULT_SPOTIFY_CLIENT_SECRET=

# ------------------------------------------------------------------- agentmail
#
# Optional. The AgentMail API key AMETHYST uses for its own inbox
# (https://docs.agentmail.to). When set, mail tools and automation email
# delivery go through AgentMail; otherwise Gmail is used.
AGENTMAIL_API_KEY=

# --------------------------------------------------- cloudflare & search keys
#
# Optional. Cloudflare Workers AI gives you zero-cost embeddings and inference.
# Tavily provides fast AI web search.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_KEY=
TAVILY_API_KEY=

# --------------------------------------- cloudflare worker relay & instagram
#
# Optional. The Cloudflare Worker relay captures Instagram reels and phone shares
# 24/7 even while your computer is closed or asleep (see relay/README.md).
AMETHYST_RELAY_URL=
AMETHYST_RELAY_TOKEN=

# ----------------------------------------------------------- amethyst notifier
#
# Free cloud & local notifications subsystem (briefing, digest, library alerts).
# Runs in GitLab CI (or locally) with zero paid services.

# Recipient: Hardcoded recipient email. The LLM NEVER sets recipients.
NOTIFIER_RECIPIENT_EMAIL=

# AgentMail: Sender inbox details (free tier: 100 sends/day, 3000/mo).
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=

# Cloud State (Turso): Free libSQL database for deduplication and daily send cap.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Composio: Direct tool execution for Gmail and Google Calendar.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# Discord: Bot token for mentions and replies via REST API.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=
DISCORD_USER_ID=

# Tool-less LLM Provider (Free Tier): groq, gemini, cerebras, openrouter, or auto.
NOTIFIER_LLM_PROVIDER=auto
NOTIFIER_LLM_API_KEY=
NOTIFIER_LLM_MODEL=

# Send Controls: Quiet hours, timezone, and daily send cap (<100).
NOTIFIER_TIMEZONE=Asia/Kolkata
NOTIFIER_QUIET_HOURS_START=23:00
NOTIFIER_QUIET_HOURS_END=07:00
NOTIFIER_DAILY_CAP=80
NOTIFIER_LIBRARY_BATCH_SECONDS=600


