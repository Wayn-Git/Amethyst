{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "amethyst-ui/no-raw-controls": "warn"
  },
  "jsPlugins": [
    {
      "name": "amethyst-ui",
      "specifier": "./lint/ui-controls.js"
    }
  ],
  "overrides": [
    {
      "files": [
        "src/components/ui/**",
        "src/components/base/**",
        "src/components/application/modals/**",
        "src/components/application/notifications/**",
        "src/dashboard/primitives.jsx"
      ],
      "rules": {
        "amethyst-ui/no-raw-controls": "off"
      }
    },
    {
      "files": [
        "src/dashboard/**",
        "src/dev/Widgets.jsx"
      ],
      "rules": {
        "amethyst-ui/no-raw-controls": "error"
      }
    }
  ]
}
