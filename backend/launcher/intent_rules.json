{
  "version": 1,
  "prefixes": [
    { "mode": "question", "pattern": "^\\?\\s*" },
    { "mode": "web", "pattern": "^>\\s*(?:g|google|web)(?:\\s+|$)" },
    { "mode": "youtube", "pattern": "^>\\s*(?:yt|youtube)(?:\\s+|$)" },
    { "mode": "images", "pattern": "^>\\s*(?:img|image|images)(?:\\s+|$)" },
    { "mode": "library", "pattern": "^>\\s*(?:lib|library)(?:\\s+|$)" },
    { "mode": "tasks", "pattern": "^>\\s*(?:task|tasks|todo)(?:\\s+|$)" },
    { "mode": "github", "pattern": "^>\\s*(?:gh|github)(?:\\s+|$)" },
    { "mode": "wiki", "pattern": "^>\\s*(?:wiki|wikipedia)(?:\\s+|$)" },
    { "mode": "files", "pattern": "^>\\s*(?:file|files)(?:\\s+|$)" },
    { "mode": "windows", "pattern": "^>\\s*(?:win|window|windows)(?:\\s+|$)" },
    { "mode": "clipboard", "pattern": "^>\\s*(?:cb|clip|clipboard)(?:\\s+|$)" },
    { "mode": "system", "pattern": "^>\\s*(?:sys|system)(?:\\s+|$)" },
    { "mode": "apps", "pattern": "^>\\s*(?:app|apps)(?:\\s+|$)" },
    { "mode": "commands", "pattern": "^>\\s*" },
    { "mode": "web", "pattern": "^(?:g|google|web)\\s+" },
    { "mode": "youtube", "pattern": "^(?:yt|youtube)\\s+" },
    { "mode": "images", "pattern": "^(?:img|image|images|pic|pics|photo|photos)\\s+" },
    { "mode": "library", "pattern": "^(?:lib|library)\\s+" },
    { "mode": "tasks", "pattern": "^(?:task|tasks|todo)\\s+" },
    { "mode": "github", "pattern": "^(?:gh|github)\\s+" },
    { "mode": "wiki", "pattern": "^(?:wiki|wikipedia)\\s+" }
  ],
  "rules": [
    {
      "mode": "url",
      "patterns": ["^https?://\\S+$", "^www\\.\\S+$"]
    },
    {
      "mode": "math",
      "patterns": [
        "^(?=.*\\d)(?=.*[+\\-*/^%])[\\d\\s+\\-*/^%().,eE]+\\??$",
        "^\\d+(?:\\.\\d+)?\\s*[a-zA-Z]{1,8}\\s+(?:to|in)\\s+[a-zA-Z]{1,8}$",
        "^=\\s*[\\d\\s+\\-*/^%().,eE]+$"
      ],
      "min_length": 3
    },
    {
      "mode": "system",
      "patterns": [
        "^(?:lock|lock (?:the )?(?:screen|session))$",
        "^(?:sleep|suspend|standby)$",
        "^(?:shut ?down|power off|turn off|reboot|restart(?: (?:the )?(?:system|computer|pc|machine))?)$",
        "^(?:volume|mute|unmute|sound|vol)(?: (?:up|down|mute|unmute))?$",
        "^(?:brightness)(?: (?:up|down))?$",
        "^(?:empty trash|empty the trash)$"
      ]
    },
    {
      "mode": "clipboard",
      "patterns": ["^(?:clipboard|clip ?history|recent clips?|copied text)$"],
      "strip": true
    },
    {
      "mode": "files",
      "patterns": [
        "^(?:~|/|\\./|\\.\\./)\\S*$",
        "\\.[A-Za-z][A-Za-z0-9]{1,7}$",
        "^(?:find|open)\\s+file\\b"
      ]
    },
    {
      "mode": "commands",
      "patterns": [
        "^(?:go to|goto|switch to|open)\\s+(?:settings|preferences|dashboard|home|chat|library|tasks|notes|memory|today|automations)\\b"
      ]
    },
    {
      "mode": "windows",
      "patterns": ["^switch\\s+to\\s+\\S.*$"]
    },
    {
      "mode": "apps",
      "patterns": ["^(?:open|launch|start|run)\\s+.+"]
    },
    {
      "mode": "question",
      "patterns": [
        "^(?:when|where|who|what|why|how|which|whose)\\b",
        "\\b(?:is|are|was|were|did|does|do|can|could|will|would|has|have)\\b.*\\?$",
        "\\?$"
      ],
      "min_length": 8
    },
    {
      "mode": "youtube",
      "patterns": ["^(?:youtube|video|videos|watch|tutorial|tutorials)\\b"]
    },
    {
      "mode": "images",
      "patterns": ["^(?:image|images|photo|photos|pic|pics|picture|pictures|wallpaper|wallpapers|logo|logos)\\b"]
    },
    {
      "mode": "github",
      "patterns": ["^(?:github|gh|repo|repos|repository|repositories)\\b"]
    }
  ],
  "fallback": {
    "short_max_words": 2,
    "short": "local",
    "default": "search"
  },
