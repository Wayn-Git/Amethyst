{
  "name": "amethyst",
  "version": "0.1.5-beta",
  "description": "Amethyst Desktop Application",
  "author": {
    "name": "Amethyst Authors",
    "email": "dev@amethyst.ai"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev:desktop": "cross-env ELECTRON_DEV=1 electron .",
    "package:desktop": "electron-builder",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "python scripts/build_backend_binary.py",
    "build:all": "npm run build:frontend && npm run build:backend"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
