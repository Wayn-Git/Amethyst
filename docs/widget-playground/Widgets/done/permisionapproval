      </Card>
      <Show when={pendingCount < size(requests)}>
        <Row>
          <Button
            label={copy.reset}
            iconStart="reload"
            variant="ghost"
            size="2xl"
            $onClickAction='{ patchState: requests.map((request, i) => set("requests." + String(i) + ".decision", "pending")) }'
          />
        </Row>
      </Show>
    </Box>
  </Basic>
</Scope>


