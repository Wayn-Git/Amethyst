<Basic align="center" gap={4}>
  <Box width="100%" maxWidth={420} gap={4}>
    <Col gap={3}>
      <Row justify="between" gap={2}>
        <Text value={labels.collection} size="sm" weight="semibold" />
        <Caption value={labels.layoutCount} />
      </Row>
      <Col gap={1}>
        <Label value={labels.direction} fieldName="direction" />
        <Select
          name="direction"
          bind="direction"
          options={directions}
          block
          size="2xl"
        />
      </Col>
      <Row gap={2}>
        <Col flex={1} minWidth={0}>
          <SegmentedControl
            name="layoutSize"
            bind="layoutSize"
            options={sizes}
            ariaLabel={labels.sizeLabel}
            block
            size="2xl"
          />
        </Col>
        <Button
          iconStart={darkMode ? "sun" : "moon"}
          ariaLabel={darkMode ? labels.lightAction : labels.darkAction}
          uniform
          variant="outline"
          size="2xl"
          onClickAction={{ updateState: { darkMode: !darkMode } }}
        />
      </Row>
    </Col>

    <Show when={direction === "minimal" && layoutSize === "medium"}>
      <Card
        width="100%"
        size="md"
        padding={4}
        gap={3}
        theme={darkMode ? "dark" : "light"}
      >
        <Row gap={2}>
          <Icon name="message" color={accent} size="sm" />
          <Title value={labels.title} size="sm" />
          <Spacer />
          <Caption value="3" />
        </Row>
        <Scope values={{ dm: messages[0] }}>
          <Col gap={3}>
            <Row gap={3}>
              <Avatar
                name={dm.name}
                src={availableImages[dm.photo].url}
                size={42}
              />
              <Col flex={1} minWidth={0} gap={0}>
                <Text value={dm.name} size="sm" weight="semibold" />
                <Caption value={labels.latest} />
              </Col>
              <Col align="end" gap={1}>
                <Caption value={dm.time} size="sm" />
                <Row gap={1}>
                  <Box size={5} radius="full" background={accent} />
                  <Caption value={labels.unread} size="sm" color={accent} />
                </Row>
              </Col>
            </Row>
            <Text value={dm.preview} size="md" />
            <Caption value={labels.replyNeeded} />
          </Col>
        </Scope>
        <Divider />
        <Col gap={3}>
          <Each of={messages.slice(1, 3)} item="dm">
            <Row key={dm.id} align="start" gap={2}>
              <Avatar
                name={dm.name}
                src={availableImages[dm.photo].url}
                size={28}
              />
              <Col flex={1} minWidth={0} gap={1}>
                <Row gap={1}>
                  <Text value={dm.name} size="sm" weight="medium" />
                  <Show when={dm.unread}>
                    <Box size={5} radius="full" background={accent} />
                  </Show>
                </Row>
                <Caption value={dm.preview} maxLines={1} />
              </Col>
              <Caption value={dm.time} size="sm" />
            </Row>
          </Each>
        </Col>
      </Card>
    </Show>

    <Show when={direction === "minimal" && layoutSize === "large"}>
      <Card
        width="100%"
        size="md"
        padding={4}
        gap={4}
        theme={darkMode ? "dark" : "light"}
      >
        <Col gap={1}>
          <Caption value={workspace} />
          <Row gap={2}>
            <Title value={labels.title} size="sm" />
            <Spacer />
            <Caption value={labels.sixWaiting} />
          </Row>
        </Col>
        <Scope values={{ dm: messages[0] }}>
          <Col gap={3}>
            <Row gap={2}>
              <Avatar
                name={dm.name}
                src={availableImages[dm.photo].url}
                size={36}
              />
              <Text value={dm.name} size="sm" weight="semibold" />
              <Box size={5} radius="full" background={accent} />
              <Spacer />
              <Caption value={dm.time} size="sm" />
            </Row>
            <Text value={dm.preview} size="lg" weight="medium" />
            <Caption value={labels.latestReply} />
          </Col>
        </Scope>
        <Divider />
        <Each of={minimalGroups} item="group">
          <Col key={group.label} gap={2}>
            <Caption value={group.label} weight="medium" />
            <Each of={group.indices.map((i) => messages[i])} item="dm">
              <Row
                key={dm.id}
                gap={2}
                align="start"
                padding={{ x: 2, y: 2 }}
                radius="sm"
                background={dm.oldest ? waitSurface : "transparent"}
              >
                <Avatar
                  name={dm.name}
                  src={availableImages[dm.photo].url}
                  size={28}
                />
                <Col flex={1} minWidth={0} gap={1}>
                  <Row gap={1}>
                    <Text value={dm.name} size="sm" weight="medium" />
                    <Show when={dm.unread}>
                      <Box size={5} radius="full" background={accent} />
                    </Show>
                  </Row>
                  <Caption value={dm.preview} maxLines={1} />
                  <Show when={dm.oldest}>
                    <Caption value={dm.waitLabel} color={waitColor} size="sm" />
                  </Show>
                </Col>
                <Caption value={dm.time} size="sm" />
              </Row>
            </Each>
          </Col>
        </Each>
      </Card>
    </Show>

    <Show when={direction === "conversation" && layoutSize === "medium"}>
      <Card
        width="100%"
        size="md"
        padding={4}
        gap={4}
        theme={darkMode ? "dark" : "light"}
      >
        <Row gap={2}>
          <Title value={labels.needsReply} size="sm" />
          <Spacer />
          <Caption value={labels.threeConversations} />
        </Row>
        <Each of={messages.slice(0, 3)} item="dm">
          <Row key={dm.id} align="start" gap={2}>
            <Avatar
              name={dm.name}
              src={availableImages[dm.photo].url}
              size={30}
            />
            <Col flex={1} minWidth={0} gap={2}>
              <Row gap={1}>
                <Text value={dm.name} size="sm" weight="semibold" />
                <Show when={dm.unread}>
                  <Box size={5} radius="full" background={accent} />
                </Show>
                <Spacer />
                <Caption value={dm.time} size="sm" />
              </Row>
              <Box background="surface-secondary" padding={3} radius="lg">
                <Text value={dm.preview} size="sm" />
              </Box>
              <Caption value={labels.replyNeeded} size="sm" />
            </Col>
          </Row>
        </Each>
      </Card>
    </Show>

    <Show when={direction === "conversation" && layoutSize === "large"}>
      <Card
        width="100%"
        size="md"
        padding={4}
        gap={4}
        theme={darkMode ? "dark" : "light"}
      >
        <Row gap={3}>
          <Box
            size={32}
            radius="sm"
            background={accentSurface}
            align="center"
            justify="center"
          >
            <Icon name="message" color={accent} />
          </Box>
          <Col flex={1} gap={0}>
            <Title value={labels.directMessages} size="sm" />
            <Caption value={workspace} />
          </Col>
          <Caption value={labels.fiveWaiting} />
        </Row>
        <Each of={conversationGroups} item="group">
          <Col key={group.label} gap={3}>
            <Row gap={2}>
              <Caption value={group.label} weight="medium" />
              <Spacer />
              <Caption value={group.detail} size="sm" />
            </Row>
            <Each of={group.indices.map((i) => messages[i])} item="dm">
              <Col key={dm.id} gap={2}>
                <Row gap={2}>
                  <Avatar
                    name={dm.name}
                    src={availableImages[dm.photo].url}
                    size={24}
                  />
                  <Text value={dm.name} size="sm" weight="semibold" />
                  <Show when={dm.unread}>
                    <Box size={5} radius="full" background={accent} />
                  </Show>
                  <Spacer />
                  <Caption value={dm.time} size="sm" />
                </Row>
                <Col padding={{ left: 8 }} gap={2}>
                  <Show when={dm.oldest}>
                    <Text value={dm.context} size="xs" color="secondary" />
                  </Show>
                  <Box
                    background={dm.oldest ? waitSurface : "surface-secondary"}
                    padding={3}
                    radius="md"
                  >
                    <Text value={dm.preview} size="sm" />
                  </Box>
                  <Show when={dm.oldest}>
                    <Row gap={1}>
                      <Icon name="hourglass" size="xs" color={waitColor} />
                      <Caption
                        value={dm.waitLabel}
                        size="sm"
                        color={waitColor}
                      />
                    </Row>
                  </Show>
                </Col>
              </Col>
            </Each>
          </Col>
        </Each>
        <Caption value={labels.allNeedReply} size="sm" />
      </Card>
    </Show>

    <Show when={direction === "inbox" && layoutSize === "medium"}>
      <Card
        width="100%"
        size="md"
        padding={4}
        gap={3}
        theme={darkMode ? "dark" : "light"}
      >
        <Row gap={2}>
          <Col gap={1}>
            <Title value={labels.title} size="sm" />
            <Caption value={workspace} />
          </Col>
          <Spacer />
          <Text
            value="4"
            size="xl"
            weight="medium"
            color="secondary"
            tabularNums
          />
        </Row>
        <Col gap={0}>
          <Each of={messages.slice(0, 4)} item="dm" index="i">
            <Row key={dm.id} gap={3} padding={{ y: 3 }} align="start">
              <Avatar
                name={dm.name}
                src={availableImages[dm.photo].url}
                size={36}
              />
              <Col flex={1} minWidth={0} gap={1}>
                <Row gap={1}>
                  <Text
                    value={dm.name}
                    size="sm"
                    weight={dm.unread ? "semibold" : "medium"}
                  />
                  <Show when={dm.unread}>
                    <Box size={6} radius="full" background={accent} />
                  </Show>
                </Row>
                <Text
                  value={dm.preview}
                  size="sm"
                  color="secondary"
                  maxLines={1}
                />
              </Col>
              <Caption value={dm.time} size="sm" />
            </Row>
            <Show when={i < 3}>
              <Divider color="subtle" />
            </Show>
          </Each>
        </Col>
        <Caption value={labels.replyNeeded} size="sm" />
      </Card>
    </Show>

    <Show when={direction === "inbox" && layoutSize === "large"}>
      <Card
        width="100%"
        size="md"
        padding={0}
        gap={0}
        theme={darkMode ? "dark" : "light"}
      >
        <Row padding={4} gap={3}>
          <Box
            size={34}
            radius="sm"
            background={accentSurface}
            align="center"
            justify="center"
          >
            <Text
              value={workspaceInitial}
              size="sm"
              weight="bold"
              color={accent}
            />
          </Box>
          <Col flex={1} gap={1}>
            <Title value={labels.title} size="sm" />
            <Caption value={workspace} />
          </Col>
          <Caption value="6" />
        </Row>
        <Each of={standardGroups} item="group">
          <Col key={group.label} gap={0}>
            <Row
              background="surface-secondary"
              padding={{ x: 4, y: 2 }}
              justify="between"
            >
              <Caption value={group.label} weight="medium" />
              <Caption value={String(size(group.indices))} size="sm" />
            </Row>
            <Each
              of={group.indices.map((i) => messages[i])}
              item="dm"
              index="i"
            >
              <Row
                key={dm.id}
                gap={3}
                padding={{ x: 4, y: 3 }}
                align="start"
                background={dm.oldest ? waitSurface : "transparent"}
              >
                <Avatar
                  name={dm.name}
                  src={availableImages[dm.photo].url}
                  size={34}
                />
                <Col flex={1} minWidth={0} gap={1}>
                  <Row gap={1}>
                    <Text
                      value={dm.name}
                      size="sm"
                      weight={dm.unread ? "semibold" : "medium"}
                    />
                    <Show when={dm.unread}>
                      <Box size={6} radius="full" background={accent} />
                    </Show>
                  </Row>
                  <Text
                    value={dm.preview}
                    size="sm"
                    color="secondary"
                    maxLines={1}
                  />
                  <Show when={dm.oldest}>
                    <Caption value={dm.waitLabel} size="sm" color={waitColor} />
                  </Show>
                </Col>
                <Caption value={dm.time} size="sm" />
              </Row>
              <Show when={i < size(group.indices) - 1}>
                <Box padding={{ left: 15, right: 4 }}>
                  <Divider color="subtle" />
                </Box>
              </Show>
            </Each>
          </Col>
        </Each>
        <Col padding={{ x: 4, y: 3 }}>
          <Caption value={labels.allNeedReply} size="sm" />
        </Col>
      </Card>
    </Show>

    <Show when={direction === "timeline" && layoutSize === "medium"}>
      <Card
        width="100%"
        size="md"
        padding={4}
        gap={4}
        theme={darkMode ? "dark" : "light"}
      >
        <Col gap={1}>
          <Row gap={2}>
            <Icon name="clock" size="sm" color="secondary" />
            <Title value={labels.stillWaiting} size="sm" />
            <Spacer />
            <Caption value="4" />
          </Row>
          <Caption value={labels.latestFirst} />
        </Col>
        <Col gap={0}>
          <Each of={messages.slice(0, 4)} item="dm" index="i">
            <Row key={dm.id} align="start" gap={3}>
              <Col width={28} align="center" gap={2}>
                <Avatar
                  name={dm.name}
                  src={availableImages[dm.photo].url}
                  size={28}
                />
                <Show when={i < 3}>
                  <Box width={1} height={44} background="surface-tertiary" />
                </Show>
              </Col>
              <Col flex={1} minWidth={0} gap={2} padding={{ bottom: 4 }}>
                <Row gap={1}>
                  <Text value={dm.name} size="sm" weight="semibold" />
                  <Show when={dm.unread}>
                    <Box size={5} radius="full" background={accent} />
                  </Show>
                  <Spacer />
                  <Caption value={dm.time} size="sm" />
                </Row>
                <Text
                  value={dm.preview}
                  size="sm"
                  color="secondary"
                  maxLines={2}
                />
              </Col>
            </Row>
          </Each>
        </Col>
        <Caption value={labels.replyNeeded} size="sm" />
      </Card>
    </Show>

    <Show when={direction === "timeline" && layoutSize === "large"}>
      <Card
        width="100%"
        size="md"
        padding={4}
        gap={4}
        theme={darkMode ? "dark" : "light"}
      >
        <Col gap={1}>
          <Title value={labels.waitingOnYou} size="sm" />
          <Caption value={labels.timelineSubtitle} />
        </Col>
        <Each of={standardGroups} item="group">
          <Col key={group.label} gap={3}>
            <Row justify="between" gap={2}>
              <Text value={group.label} size="sm" weight="semibold" />
              <Caption value={group.detail} size="sm" />
            </Row>
            <Col gap={0}>
              <Each
                of={group.indices.map((i) => messages[i])}
                item="dm"
                index="i"
              >
                <Row key={dm.id} gap={2} align="start">
                  <Col width={48} align="end" gap={0}>
                    <Caption value={dm.shortTime} size="sm" tabularNums />
                    <Caption value={dm.periodLabel} size="sm" />
                  </Col>
                  <Col width={12} align="center" gap={2} padding={{ top: 1 }}>
                    <Box
                      size={6}
                      radius="full"
                      background={dm.oldest ? waitColor : "surface-tertiary"}
                    />
                    <Show when={i < size(group.indices) - 1}>
                      <Box
                        width={1}
                        height={62}
                        background="surface-tertiary"
                      />
                    </Show>
                  </Col>
                  <Col flex={1} minWidth={0} gap={2} padding={{ bottom: 4 }}>
                    <Row gap={2}>
                      <Avatar
                        name={dm.name}
                        src={availableImages[dm.photo].url}
                        size={22}
                      />
                      <Text value={dm.name} size="sm" weight="medium" />
                      <Show when={dm.unread}>
                        <Box size={5} radius="full" background={accent} />
                      </Show>
                    </Row>
                    <Text
                      value={dm.preview}
                      size="sm"
                      color="secondary"
                      maxLines={2}
                    />
                    <Show when={dm.oldest}>
                      <Caption
                        value={dm.waitLabel}
                        color={waitColor}
                        size="sm"
                      />
                    </Show>
                  </Col>
                </Row>
              </Each>
            </Col>
          </Col>
        </Each>
        <Caption value={snapshotLabel} size="sm" />
      </Card>
    </Show>

    <Show when={direction === "priority" && layoutSize === "medium"}>
      <Card
        width="100%"
        size="md"
        padding={4}
        gap={4}
        theme={darkMode ? "dark" : "light"}
      >
        <Row gap={2}>
          <Title value={labels.replyQueue} size="sm" />
          <Spacer />
          <Caption value={labels.threeWaiting} />
        </Row>
        <Scope values={{ dm: messages[5] }}>
          <Box
            border={{ left: { size: 2, color: waitColor } }}
            padding={{ left: 3 }}
            gap={3}
          >
            <Caption value={labels.waitingLongest} color={waitColor} />
            <Row gap={2}>
              <Avatar
                name={dm.name}
                src={availableImages[dm.photo].url}
                size={36}
              />
              <Col flex={1} gap={0}>
                <Text value={dm.name} size="sm" weight="semibold" />
                <Caption value={dm.time} size="sm" />
              </Col>
            </Row>
            <Text value={dm.preview} size="md" />
            <Row gap={1}>
              <Icon name="hourglass" color={waitColor} size="xs" />
              <Caption value={dm.waitLabel} color={waitColor} />
            </Row>
          </Box>
        </Scope>
        <Divider />
        <Col gap={3}>
          <Each of={priorityMedium.map((i) => messages[i])} item="dm">
            <Row key={dm.id} align="start" gap={2}>
              <Avatar
                name={dm.name}
                src={availableImages[dm.photo].url}
                size={28}
              />
              <Col flex={1} minWidth={0} gap={1}>
                <Row gap={1}>
                  <Text value={dm.name} size="sm" weight="medium" />
                  <Show when={dm.unread}>
                    <Box size={5} radius="full" background={accent} />
                  </Show>
                </Row>
                <Caption value={dm.preview} maxLines={1} />
              </Col>
              <Col align="end" gap={1}>
                <Caption value={dm.time} size="sm" />
                <Caption value={dm.waitShort} size="sm" />
              </Col>
            </Row>
          </Each>
        </Col>
      </Card>
    </Show>

    <Show when={direction === "priority" && layoutSize === "large"}>
      <Card
        width="100%"
        size="md"
        padding={4}
        gap={4}
        theme={darkMode ? "dark" : "light"}
      >
        <Col gap={1}>
          <Caption value={workspace} />
          <Row gap={2}>
            <Title value={labels.replyPriorities} size="sm" />
            <Spacer />
            <Caption value={labels.sixWaiting} />
          </Row>
        </Col>
        <Row gap={3} padding={3} radius="md" background={waitSurface}>
          <Icon name="hourglass" size="lg" color={waitColor} />
          <Col gap={0}>
            <Caption value={labels.waitingLongest} color={waitColor} />
            <Text
              value={messages[5].waitShort}
              size="xl"
              weight="semibold"
              color={waitColor}
            />
          </Col>
          <Spacer />
          <Col align="end" gap={1}>
            <Text value={labels.oldestFirst} size="sm" weight="medium" />
            <Caption value={labels.earlierAtTop} size="sm" />
          </Col>
        </Row>
        <Each of={priorityGroups} item="group">
          <Col key={group.label} gap={3}>
            <Row justify="between">
              <Text value={group.label} size="sm" weight="semibold" />
              <Caption value={String(size(group.indices))} size="sm" />
            </Row>
            <Each of={group.indices.map((i) => messages[i])} item="dm">
              <Box
                key={dm.id}
                border={dm.oldest ? { left: { size: 2, color: waitColor } } : 0}
                padding={dm.oldest ? { left: 3 } : 0}
                gap={2}
              >
                <Row gap={2}>
                  <Avatar
                    name={dm.name}
                    src={availableImages[dm.photo].url}
                    size={26}
                  />
                  <Text
                    value={dm.name}
                    size="sm"
                    weight={dm.oldest || dm.unread ? "semibold" : "medium"}
                  />
                  <Show when={dm.unread}>
                    <Box size={5} radius="full" background={accent} />
                  </Show>
                  <Spacer />
                  <Caption
                    value={dm.waitShort}
                    color={dm.oldest ? waitColor : "secondary"}
                    size="sm"
                  />
                </Row>
                <Text
                  value={dm.preview}
                  size="sm"
                  color="secondary"
                  maxLines={2}
                />
                <Caption value={dm.time} size="sm" />
              </Box>
            </Each>
          </Col>
        </Each>
      </Card>
    </Show>

    <Col gap={1}>
      <Row gap={1}>
        <Box size={5} radius="full" background={accent.light} />
        <Caption value={labels.legend} size="sm" />
      </Row>
      <Caption value={labels.demoNote} size="sm" />
    </Col>
  </Box>
</Basic>

