                          variant="ghost"
                          size="2xl"
                          onClickAction={{
                            updateState: {
                              draftOpen: true,
                              draftTo: item.name,
                              draft:
                                draftParts.greeting +
                                item.firstName +
                                draftParts.body +
                                item.subject +
                                draftParts.ending,
                            },
                          }}
                        />
                      </Col>
                    </Row>
                  </Col>
                </Each>
              </Col>
              <Divider />
              <Col gap={3}>
                <Caption value={labels.withinWindow} />
                <Each of={visible.filter((item) => !item.due)} item="item">
