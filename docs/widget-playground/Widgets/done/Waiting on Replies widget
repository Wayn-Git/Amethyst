  <Basic gap={3}>
    <Box width="100%" maxWidth={440} gap={3}>
      <Caption value={catalogLabel} />
      <Col gap={1}>
        <Label value={labels.composition} fieldName="layout" />
        <Select
          name="layout"
          bind="layout"
          options={layouts}
          block
          size="2xl"
        />
      </Col>
      <Row justify="between" wrap="wrap" gap={3}>
        <SegmentedControl
          name="sizeChoice"
          bind="sizeChoice"
          options={sizes}
          ariaLabel={labels.sizeLabel}
          size="2xl"
        />
        <Row gap={2}>
          <Text value={labels.dark} size="sm" color="secondary" />
          <Toggle
            name="darkPreview"
            bind="darkPreview"
            variant="switch"
            label={labels.darkAppearance}
          />
        </Row>
      </Row>
      <Card
        size="full"
        width="100%"
        padding={4}
        gap={4}
        theme={darkPreview ? "dark" : "light"}
      >
        <Col gap={1}>
          <Row gap={3} align="baseline">
            <Title value={title} size="sm" />
            <Spacer />
            <Text
              value={String(size(visible))}
              size="xl"
              weight="semibold"
              color="secondary"
              tabularNums
            />
          </Row>
          <Caption value={snapshot} size="sm" />
        </Col>
        <Show when={layout === "minimal"}>
          <Col gap={4}>
            <Box background="surface-secondary" radius="xl" padding={4} gap={3}>
              <Row gap={2}>
                <Icon name="clock" size="sm" color="warning" />
                <Text value={labels.longestWaiting} size="sm" weight="medium" />
              </Row>
              <Row align="start" gap={3}>
                <Box
                  size={40}
                  minWidth={40}
                  radius="full"
                  background="surface-tertiary"
                  align="center"
                  justify="center"
                >
                  <Text value={oldest.initials} size="sm" weight="medium" />
                </Box>
                <Col flex={1} minWidth={0} gap={1}>
                  <Text value={oldest.name} weight="semibold" />
                  <Text value={oldest.subject} size="sm" />
                  <Caption
                    value={
                      (sizeChoice === "large"
                        ? oldest.sentAt
                        : oldest.sentDate) +
                      " · " +
                      oldest.source
                    }
                  />
                </Col>
                <Stat
                  label={labels.waiting}
                  value={oldest.wait}
                  size="sm"
                  align="end"
                />
              </Row>
              <Show when={sizeChoice === "large"}>
                <Text value={oldest.preview} size="sm" color="secondary" />
              </Show>
              <Row>
                <Button
                  label={labels.draftFollowUp}
                  iconStart="write"
                  variant="outline"
                  size="2xl"
                  onClickAction={{
                    updateState: {
                      draftOpen: true,
                      draftTo: oldest.name,
                      draft:
                        draftParts.greeting +
                        oldest.firstName +
                        draftParts.body +
                        oldest.subject +
                        draftParts.ending,
                    },
                  }}
                />
              </Row>
            </Box>
            <Col gap={3}>
              <Caption
                value={labels.alsoWaiting + " · " + String(size(visible) - 1)}
              />
              <Each of={visible.slice(1)} item="item" index="i">
                <Col key={item.id} gap={2}>
                  <Show when={i > 0}>
                    <Divider color="subtle" />
                  </Show>
                  <Row align="start" gap={3}>
                    <Col flex={1} minWidth={0} gap={1}>
                      <Text value={item.name} size="sm" weight="semibold" />
                      <Text value={item.subject} size="sm" />
                      <Show when={sizeChoice === "large"}>
                        <Text
                          value={item.preview}
                          size="sm"
                          color="secondary"
                        />
                      </Show>
                      <Caption
                        value={
                          (sizeChoice === "large"
                            ? item.sentAt
                            : item.sentDate) +
                          " · " +
                          item.source
                        }
                        size="sm"
                      />
                    </Col>
                    <Col align="end" gap={1} minWidth={58}>
                      <Text
                        value={item.wait}
                        size="sm"
                        weight="medium"
                        tabularNums
                        color={item.due ? "warning" : "secondary"}
                      />
                      <Show when={sizeChoice === "large"}>
                        <Caption
                          value={item.status}
                          size="sm"
                          color={
                            item.due
                              ? "warning"
                              : item.recent
                                ? "info"
                                : "secondary"
                          }
                        />
                      </Show>
                    </Col>
                  </Row>
                </Col>
              </Each>
            </Col>
          </Col>
          <Show.ElseIf when={layout === "inbox"}>
            <Table columnSizing="auto">
              <Table.Row header>
                <Table.Cell header>
                  <Text value={labels.message} size="xs" color="secondary" />
                </Table.Cell>
                <Table.Cell header width={78}>
                  <Text value={labels.sent} size="xs" color="secondary" />
                </Table.Cell>
                <Table.Cell header align="end" width={68}>
                  <Text value={labels.waiting} size="xs" color="secondary" />
                </Table.Cell>
              </Table.Row>
              <Each of={visible} item="item">
                <Table.Row key={item.id}>
                  <Table.Cell vAlign="top">
                    <Col gap={1} padding={{ y: 1 }}>
                      <Row gap={2} align="start">
                        <Box
                          size={26}
                          minWidth={26}
                          radius="full"
                          background="surface-secondary"
                          align="center"
                          justify="center"
                        >
                          <Text
                            value={item.initials}
                            size="xs"
                            weight="medium"
                          />
                        </Box>
                        <Text value={item.name} size="sm" weight="semibold" />
                      </Row>
                      <Text value={item.subject} size="sm" />
                      <Show when={sizeChoice === "large"}>
                        <Text
                          value={item.preview}
                          size="sm"
                          color="secondary"
                        />
                      </Show>
                      <Caption value={item.source} size="sm" />
                    </Col>
                  </Table.Cell>
                  <Table.Cell vAlign="top">
                    <Col gap={1} padding={{ y: 1 }}>
                      <Text value={item.sentDay} size="xs" color="secondary" />
                      <Show when={sizeChoice === "large"}>
                        <Caption value={item.sentTime} size="sm" />
                      </Show>
                    </Col>
                  </Table.Cell>
                  <Table.Cell align="end" vAlign="top">
                    <Col align="end" gap={1} padding={{ y: 1 }}>
                      <Text
                        value={item.wait}
                        size="sm"
                        weight={item.id === oldest.id ? "semibold" : "medium"}
                        color={item.due ? "warning" : "secondary"}
                        tabularNums
                      />
                      <Show when={item.id === oldest.id}>
                        <Text
                          value={labels.longest}
                          size="xs"
                          weight="medium"
                          color="warning"
                        />
                        <Show.Else>
                          <Show when={sizeChoice === "large"}>
                            <Caption
                              value={item.status}
                              size="sm"
                              color={
                                item.due
                                  ? "warning"
                                  : item.recent
                                    ? "info"
                                    : "secondary"
                              }
                            />
                          </Show>
                        </Show.Else>
                      </Show>
                    </Col>
                  </Table.Cell>
                </Table.Row>
              </Each>
            </Table>
          </Show.ElseIf>
          <Show.ElseIf when={layout === "timeline"}>
            <Col gap={0}>
              <Each of={visible} item="item" index="i">
                <Row key={item.id} align="stretch" gap={3}>
                  <Col
                    width={65}
                    minWidth={65}
                    gap={1}
                    padding={{ top: 1, bottom: 4 }}
                  >
                    <Text value={item.sentDay} size="sm" weight="medium" />
                    <Show when={sizeChoice === "large"}>
                      <Caption value={item.sentTime} size="sm" />
                    </Show>
                  </Col>
                  <Col
                    flex={1}
                    minWidth={0}
                    gap={2}
                    border={{ left: { size: 1, color: "subtle" } }}
                    padding={{ left: 4, bottom: 5 }}
                  >
                    <Row gap={2}>
                      <Box
                        size={28}
                        minWidth={28}
                        radius="full"
                        background="surface-secondary"
                        align="center"
                        justify="center"
                      >
                        <Text value={item.initials} size="xs" weight="medium" />
                      </Box>
                      <Text value={item.name} size="sm" weight="semibold" />
                    </Row>
                    <Text value={item.subject} size="sm" />
                    <Show when={sizeChoice === "large"}>
                      <Text value={item.preview} size="sm" color="secondary" />
                    </Show>
                    <Row gap={2} wrap="wrap">
                      <Caption value={item.source} size="sm" />
                      <Text
                        value={item.wait + labels.waitingSuffix}
                        size="xs"
                        color={item.due ? "warning" : "secondary"}
                        tabularNums
                      />
                    </Row>
                    <Show when={item.id === oldest.id}>
                      <Row gap={1}>
                        <Icon name="clock" size="xs" color="warning" />
                        <Text
                          value={labels.longestWaiting}
                          size="xs"
                          color="warning"
                        />
                      </Row>
                      <Show.Else>
                        <Show when={sizeChoice === "large"}>
                          <Text
                            value={item.status}
                            size="xs"
                            color={
                              item.due
                                ? "warning"
                                : item.recent
                                  ? "info"
                                  : "secondary"
                            }
                          />
                        </Show>
                      </Show.Else>
                    </Show>
                  </Col>
                </Row>
              </Each>
            </Col>
          </Show.ElseIf>
          <Show.ElseIf when={layout === "followup"}>
            <Col gap={4}>
              <Col gap={1}>
                <Row gap={2}>
                  <Icon name="write" size="sm" color="warning" />
                  <Text
                    value={labels.readyForNudge}
                    size="sm"
                    weight="semibold"
                  />
                  <Spacer />
                  <Text
                    value={String(size(visible.filter((item) => item.due)))}
                    size="sm"
                    color="warning"
                    tabularNums
                  />
                </Row>
                <Text
                  value={labels.overdueExplanation}
                  size="sm"
                  color="secondary"
                />
              </Col>
              <Col gap={3}>
                <Each
                  of={visible.filter((item) => item.due)}
                  item="item"
                  index="i"
                >
                  <Col key={item.id} gap={3}>
                    <Show when={i > 0}>
                      <Divider color="subtle" />
                    </Show>
                    <Row gap={3} align="start">
                      <Box
                        size={34}
                        minWidth={34}
                        radius="lg"
                        background="surface-secondary"
                        align="center"
                        justify="center"
                      >
                        <Text value={item.initials} size="xs" weight="medium" />
                      </Box>
                      <Col flex={1} minWidth={0} gap={1}>
                        <Text value={item.name} size="sm" weight="semibold" />
                        <Text value={item.subject} size="sm" />
                        <Show when={sizeChoice === "large"}>
                          <Text
                            value={item.preview}
                            size="sm"
                            color="secondary"
                          />
                        </Show>
                        <Caption
                          value={
                            (sizeChoice === "large"
                              ? item.sentAt
                              : item.sentDate) +
                            " · " +
                            item.source
                          }
                          size="sm"
                        />
                      </Col>
                      <Col align="end" gap={1}>
                        <Text
                          value={item.wait}
                          size="sm"
                          weight="medium"
                          color="warning"
                          tabularNums
                        />
                        <Show when={item.id === oldest.id}>
                          <Caption
                            value={labels.longest}
                            color="warning"
                            size="sm"
                          />
                        </Show>
