                    <Col flex={1} minWidth={0} gap={1}>
                      <Text value={item.name} size="sm" weight="medium" />
                      <Text value={item.subject} size="sm" />
                      <Show when={sizeChoice === "large"}>
                        <Text
                          value={item.preview}
                          size="sm"
                          color="secondary"
                        />
                      </Show>
                      <Caption
                        value={
                          (sizeChoice === "large"
                            ? item.sentAt
                            : item.sentDate) +
                          " · " +
                          item.source
                        }
                        size="sm"
                      />
                    </Col>
                    <Col align="end" gap={1}>
                      <Text
                        value={item.wait}
                        size="sm"
                        color="secondary"
                        tabularNums
                      />
                      <Show when={sizeChoice === "large"}>
                        <Caption
                          value={item.status}
                          size="sm"
                          color={item.recent ? "info" : "secondary"}
                        />
                      </Show>
                    </Col>
                  </Row>
                </Each>
              </Col>
            </Col>
          </Show.ElseIf>
          <Show.Else>
            <Col gap={4}>
              <Each of={groups} item="group">
                <Scope
                  values={{
                    grouped: visible.filter(
                      (item) => item.sourceId === group.id,
                    ),
                  }}
                >
                  <Show when={size(grouped) > 0}>
                    <Col key={group.id} gap={2}>
                      <Row gap={2}>
                        <Icon name={group.icon} size="sm" color="secondary" />
                        <Text value={group.label} size="sm" weight="semibold" />
                        <Spacer />
                        <Caption value={String(size(grouped))} tabularNums />
                      </Row>
                      <Each of={grouped} item="item">
                        <Box
                          key={item.id}
                          background={
                            item.id === oldest.id
                              ? "surface-secondary"
                              : "transparent"
                          }
                          radius="lg"
                          padding={2}
                        >
                          <Row gap={3} align="start">
                            <Box
                              size={30}
                              minWidth={30}
                              radius="full"
                              background="surface-tertiary"
                              align="center"
                              justify="center"
                            >
                              <Text
                                value={item.initials}
                                size="xs"
                                weight="medium"
                              />
                            </Box>
                            <Col flex={1} minWidth={0} gap={1}>
                              <Text
                                value={item.name}
                                size="sm"
                                weight="semibold"
                              />
                              <Text value={item.subject} size="sm" />
                              <Show when={sizeChoice === "large"}>
                                <Text
                                  value={item.preview}
                                  size="sm"
                                  color="secondary"
                                />
                              </Show>
                              <Caption
                                value={
                                  sizeChoice === "large"
                                    ? item.sentAt
                                    : item.sentDate
                                }
                                size="sm"
                              />
                            </Col>
                            <Col align="end" gap={1} minWidth={55}>
                              <Text
                                value={item.wait}
                                size="sm"
                                color={item.due ? "warning" : "secondary"}
                                weight="medium"
                                tabularNums
                              />
                              <Show when={item.id === oldest.id}>
                                <Caption
                                  value={labels.longest}
                                  size="sm"
                                  color="warning"
                                />
                                <Show.Else>
                                  <Show when={sizeChoice === "large"}>
                                    <Caption
                                      value={item.status}
                                      size="sm"
                                      color={
                                        item.due
                                          ? "warning"
                                          : item.recent
                                            ? "info"
                                            : "secondary"
                                      }
                                    />
                                  </Show>
                                </Show.Else>
                              </Show>
                            </Col>
                          </Row>
                        </Box>
                      </Each>
                    </Col>
                  </Show>
                </Scope>
              </Each>
            </Col>
          </Show.Else>
        </Show>
        <Col key="preview-footer" gap={2}>
          <Divider color="subtle" />
          <Row gap={2} wrap="wrap">
            <Icon name="history" size="xs" color="secondary" />
            <Caption
              value={
                String(size(visible.filter((item) => item.due))) +
                labels.followUpsDue +
                " · " +
                labels.threshold
              }
              size="sm"
            />
          </Row>
          <Show when={sizeChoice === "large"}>
            <Caption value={labels.recentDefinition} size="sm" />
          </Show>
          <Caption value={labels.timeNote} size="sm" />
        </Col>
        <Show when={draftOpen}>
          <Col key="draft-editor" gap={3}>
            <Divider />
            <Row gap={2}>
              <Col flex={1} minWidth={0} gap={1}>
                <Text value={labels.localDraft} size="sm" weight="semibold" />
                <Caption
                  value={labels.toPrefix + draftTo + " · " + labels.notSent}
                />
              </Col>
              <Button
                iconStart="x"
                ariaLabel={labels.closeDraft}
                uniform
                variant="ghost"
                size="2xl"
                onClickAction={{ updateState: { draftOpen: false } }}
              />
            </Row>
            <Col gap={1}>
              <Label value={labels.draftLabel} fieldName="draft" />
              <Textarea name="draft" bind="draft" rows={4} />
            </Col>
            <Row>
              <Button
                label={labels.copyDraft}
                iconStart="copy"
                size="2xl"
                disabled={!has(draft.trim())}
                onClickAction={{
                  type: "copy",
                  handler: "client",
                  payload: { value: draft },
                }}
              />
            </Row>
          </Col>
        </Show>
      </Card>
      <Caption
        value={
          layouts.find((item) => item.value === layout).specimen +
          " · " +
          (sizeChoice === "medium"
            ? labels.mediumDescription
            : labels.largeDescription)
        }
        size="sm"
      />
    </Box>
  </Basic>
</Scope>


