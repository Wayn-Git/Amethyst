                          <Text
                            value={event.timeLabel}
                            size="sm"
                            color="secondary"
                            width={82}
                            tabularNums
                          />
                          <Col flex={1} minWidth={0} gap={0}>
                            <Text
                              value={event.title}
                              size="sm"
                              weight="medium"
                            />
                            <Caption value={event.detail} />
                          </Col>
                        </Row>
                      </Each>
                    </Col>
                    <Box
                      padding={3}
                      background="surface-secondary"
                      radius="sm"
                      gap={3}
                    >
                      <Row gap={2}>
                        <Icon name="flag" size="sm" color="secondary" />
                        <Text
                          value={labels.priorities}
                          size="sm"
                          weight="semibold"
                        />
                      </Row>
                      <Each of={priorities} item="task">
                        <Row
                          key={task.id}
                          justify="between"
                          gap={3}
                          align="baseline"
                        >
                          <Text
                            value={task.title}
                            size="sm"
                            weight={task.id === topTask ? "semibold" : "normal"}
                          />
                          <Caption value={task.deadline} />
                        </Row>
                      </Each>
                    </Box>
                  </Col>
                </Show.Else>
              </Show>
            </Show.Else>
          </Show>
        </Card>
      </Box>
      <Box width="100%" maxWidth={400} gap={1}>
        <Caption value={sampleLabel} size="sm" />
        <Caption value={previewNote} size="sm" />
      </Box>
    </Basic>
  </Scope>
</Scope>


